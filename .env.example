# Copia questo file in .env e compila i valori.
# Il .env serve a docker compose; per GitHub Actions le credenziali Docker Hub vanno nei
# secrets del repository (DOCKERHUB_USERNAME, DOCKERHUB_TOKEN).

# --- App -------------------------------------------------------------------
# In produzione: l'istanza Mongo esterna (es. Atlas). In sviluppo la imposta compose.dev.yaml.
MONGO_URI=mongodb+srv://utente:password@cluster.example.mongodb.net
MONGO_DB=santisegreti

# Client OAuth "Applicazione web" da Google Cloud Console.
# Origini JavaScript autorizzate: http://localhost:5173 (sviluppo) e il dominio di produzione.
GOOGLE_CLIENT_ID=

# Almeno 32 caratteri casuali: openssl rand -hex 32
SESSION_SECRET=

# true dietro HTTPS (produzione), false in locale su http.
COOKIE_SECURE=true

# Login senza Google per lo sviluppo. Mai true in produzione.
DEV_LOGIN=false

# --- docker compose di produzione ------------------------------------------
DOCKERHUB_USERNAME=
APP_VERSION=latest
APP_PORT=8000
